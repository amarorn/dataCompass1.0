# Application
NODE_ENV=production
PORT=3000
JWT_SECRET=your-jwt-secret-key-here
DATABASE_URL=mongodb://localhost:27017/whatsapp_analytics

# WhatsApp Business API Configuration
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=datacompass_webhook_2025
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
WHATSAPP_BUSINESS_ID=your-business-id
WHATSAPP_APP_ID=your-app-id
WHATSAPP_APP_SECRET=your-app-secret

# PyWA Specific Configuration
PYWA_SERVER_URL=https://graph.facebook.com/v21.0
PYWA_WEBHOOK_ENDPOINT=/api/whatsapp/webhook
PYWA_CALLBACK_URL=https://your-domain.com/api/whatsapp/webhook

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=whatsapp_analytics
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis Configuration (optional for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=Content-Type,Authorization

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Analytics Configuration
ENABLE_ML_FEATURES=true
ENABLE_AUTO_RESPONSES=true
ENABLE_SENTIMENT_ANALYSIS=true
