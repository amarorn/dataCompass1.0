# DataCompass 1.0 - Environment Configuration
# Configuração para ambiente de desenvolvimento

# Application
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=datacompass_jwt_secret_2025_dev

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/datacompass
MONGO_DB_NAME=datacompass

# WhatsApp Business API Configuration
# Para desenvolvimento, usar valores placeholder que ativam modo simulação
WHATSAPP_TOKEN=your-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=datacompass_webhook_2025
WHATSAPP_WEBHOOK_SECRET=datacompass_secret_2025

# API Configuration
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
