# Configurações para Docker Compose
# Copie este arquivo para .env e ajuste os valores

# WhatsApp Business API
WHATSAPP_TOKEN=seu_token_aqui
WHATSAPP_PHONE_NUMBER_ID=seu_phone_id_aqui
WHATSAPP_WEBHOOK_SECRET=datacompass_webhook_2025

# Facebook App
FACEBOOK_APP_ID=seu_app_id_aqui
FACEBOOK_APP_SECRET=seu_app_secret_aqui

# MongoDB (configurado automaticamente no docker-compose)
MONGODB_URI=mongodb://datacompass_user:datacompass_app_2025@mongo:27017/datacompass

# Aplicação
NODE_ENV=production
PORT=3000
JWT_SECRET=datacompass_jwt_secret_2025_super_secure

# Logs
LOG_LEVEL=info
