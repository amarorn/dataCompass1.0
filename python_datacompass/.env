# Application Configuration
NODE_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/datacompass
DATABASE_NAME=datacompass

# WhatsApp Business API Configuration
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=datacompass_webhook_2025
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Security Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]
CORS_HEADERS=["Content-Type", "Authorization"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["text/csv", "application/csv"]

# Analytics Configuration
ENABLE_ML_PROCESSING=true
CHART_GENERATION_TIMEOUT=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# MongoDB Configuration (for Docker)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password